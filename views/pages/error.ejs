<div class="error-page">
    <div class="container">
        <div class="error-content">
            <div class="error-illustration">
                <div class="error-icon">
                    <% if (title && title.includes('404')) { %>
                        <div class="icon-404">404</div>
                    <% } else { %>
                        <div class="icon-error">❌</div>
                    <% } %>
                </div>
            </div>

            <div class="error-details">
                <h1 class="error-title"><%= title || 'Oops! Something went wrong' %></h1>
                
                <p class="error-message"><%= message || 'An unexpected error occurred' %></p>

                <div class="error-actions">
                    <a href="/" class="btn btn-primary btn-large">
                        Back to Home
                    </a>
                    <a href="javascript:history.back()" class="btn btn-secondary btn-large">
                        <span class="btn-icon">←</span>
                        Go Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>