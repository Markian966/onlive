<div class="event-details">
  <div class="container">
      <div class="event-header">
          <div class="event-image-large">
              <img src="<%= event.imageUrl %>" alt="<%= event.name %>">
          </div>
          <div class="event-info">
              <h1 class="event-title"><%= event.name %></h1>
              <div class="event-meta">
                  <p><strong>Date:</strong> <%= new Date(event.date).toLocaleDateString('en-US') %></p>
                  <p><strong>Time:</strong> <%= event.time %></p>
                  <p><strong>Venue:</strong> <%= event.venue %></p>
                  <p><strong>Price:</strong> $<%= event.price %> per ticket</p>
              </div>
          </div>
      </div>

      <div class="event-description">
          <h2>Event Description</h2>
          <p><%= event.description %></p>
      </div>

      <% if (event.Sectors && event.Sectors.length > 0) { %>
      <div class="seating-info">
          <h2>Available Seating</h2>
          <div class="sectors-grid">
              <% event.Sectors.forEach(sector => { %>
                  <div class="sector-info">
                      <h3>Sector <%= sector.name %></h3>
                      <p>Rows: <%= sector.rows %></p>
                      <p>Seats per row: <%= sector.seatsPerRow %></p>
                      <p>Total seats: <%= sector.rows * sector.seatsPerRow %></p>
                  </div>
              <% }) %>
          </div>
      </div>
      <% } %>

      <div class="reservation-actions">
          <a href="/events/<%= event.id %>/reserve" class="btn btn-primary btn-large">
              Reserve Tickets
          </a>
          <a href="/" class="btn btn-secondary">Back to Events</a>
      </div>
  </div>
</div>